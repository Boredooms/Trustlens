# TrustLens API — names and placeholders only. Copy to .env and fill in.
# Owner: docs/08-infrastructure/ENVIRONMENT_CONFIGURATION.md

# Core
ENVIRONMENT=development
APP_VERSION=0.1.0
PORT=8000
# Local: docker compose Postgres. Hosted: Supabase pooler on 6543 (transaction mode).
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/trustlens
# Migrations only — never the pooler. Hosted: db.<project>.supabase.co:5432
DIRECT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/trustlens
# Internal HMAC only (signed export links); required (32+ chars) in production
# JWT_SECRET=
ALLOWED_ORIGINS=http://localhost:5173

# Clerk — required; startup aborts without these
CLERK_ISSUER=https://<dev-instance>.clerk.accounts.dev
CLERK_JWKS_URL=https://<dev-instance>.clerk.accounts.dev/.well-known/jwks.json
CLERK_AUTHORIZED_PARTY=http://localhost:5173
# CLERK_SECRET_KEY=

# Hosted platforms (required in production)
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# QSTASH_CURRENT_SIGNING_KEY=
# QSTASH_NEXT_SIGNING_KEY=
# RESEND_API_KEY=          # OPTIONAL — the demo sends no email

# Scanning
SCAN_CONCURRENCY=4
SCAN_BUDGET_SECONDS=60
DEEP_SCAN_ENABLED=false

# AI (optional; omit LLM_API_KEY to use template narratives)
# LLM_API_KEY=
# LLM_BASE_URL=
LLM_MODEL=provider/model-a
# LLM_EXTRA_BODY={"chat_template_kwargs":{"enable_thinking":false}}
PROMPT_VERSION=inv-1.0

# Demo and operations
DEMO_MODE=true
ALLOW_DEMO_SEED=false
LOG_LEVEL=debug
# IP_HASH_SALT=            # required in production

# ── Web3 report registry (docs/02-architecture/WEB3_REGISTRY.md §7) ─────────────
# Unset CHAIN_RPC_URL = anchoring disabled (anchor routes answer 503 CHAIN_UNAVAILABLE).
# Local: `pnpm --filter @trustlens/contracts node` then `... run deploy:local` prints these values.
# The sender must be an account the NODE has unlocked; the API never holds a private key.
# CHAIN_RPC_URL=http://127.0.0.1:8545
# CHAIN_ID=31337               # refused in production
# CHAIN_REGISTRY_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
# CHAIN_SENDER_ADDRESS=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266
# CHAIN_TIMEOUT_SECONDS=5
