# TrustLens API — NAMES AND PLACEHOLDERS ONLY. Copy to apps/api/.env (git-ignored) and fill in.
# Every variable: docs/08-infrastructure/ENVIRONMENT_CONFIGURATION.md. The API is deployable as one
# unit with only this file's variables; it never reads a VITE_* variable.
# [required] = startup aborts without it · [prod] = required when ENVIRONMENT=production · [opt] = optional
# A process env var silently overrides .env: the API logs database_host + database_source at startup.

# ── Core ─────────────────────────────────────────────────────────────────────────
ENVIRONMENT=development                  # development | test | production
APP_VERSION=0.1.0
PORT=8000
# [required] Supabase Postgres, TRANSACTION pooler (6543). The engine disables prepared statements.
DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<url-encoded-password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# [prod] SESSION pooler (5432, same host): migrations + LangGraph checkpointer (needs prepared stmts).
DIRECT_DATABASE_URL=postgresql://postgres.<project-ref>:<url-encoded-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# [opt] TCP + TLS + pooler auth budget for a new connection (seconds). Default 10.
# DB_CONNECT_TIMEOUT_SECONDS=10
# [prod] 32+ random characters (internal HMAC); [prod] salt for hashed IPs in audit logs.
JWT_SECRET=
IP_HASH_SALT=
# [required] Web origins allowed by CORS. Never "*".
ALLOWED_ORIGINS=http://localhost:5173

# ── Supabase (database only — no Supabase Auth; identity is Clerk) ───────────────
SUPABASE_URL=https://<project-ref>.supabase.co          # [prod]
SUPABASE_SECRET_KEY=                                     # [prod] sb_secret_… server-only (legacy name SUPABASE_SERVICE_ROLE_KEY accepted)

# ── Clerk (the only identity provider) ───────────────────────────────────────────
CLERK_ISSUER=https://<instance>.clerk.accounts.dev                      # [required]
CLERK_JWKS_URL=https://<instance>.clerk.accounts.dev/.well-known/jwks.json # [required]
CLERK_AUTHORIZED_PARTY=http://localhost:5173            # [required] the web origin (azp)
CLERK_SECRET_KEY=                                        # [prod] sk_… Backend API (email/name fill, deletion)
# CLERK_WEBHOOK_SECRET=                                  # [opt] whsec_… for /webhooks/clerk (503 until set)

# ── Upstash: Redis (rate limits) + QStash (signed cron) ──────────────────────────
UPSTASH_REDIS_REST_URL=                                  # [prod] absent ⇒ in-process limits + X-RateLimit-Degraded
UPSTASH_REDIS_REST_TOKEN=                                # [prod]
QSTASH_CURRENT_SIGNING_KEY=                              # [prod] verifies Upstash-Signature on /internal/jobs/*
QSTASH_NEXT_SIGNING_KEY=                                 # [opt] rotation
QSTASH_URL=https://qstash.upstash.io                     # [opt] regional URL, e.g. https://qstash-eu-central-1.upstash.io
QSTASH_TOKEN=                                            # [opt] only app.scripts.register_schedules publishes
# RESEND_API_KEY=                                        # [opt] invite emails; absent ⇒ link shown/logged

# ── Scanning ─────────────────────────────────────────────────────────────────────
SCAN_CONCURRENCY=4
SCAN_BUDGET_SECONDS=60
DEEP_SCAN_ENABLED=false

# ── AI narration (optional: absent LLM_API_KEY ⇒ deterministic template narrator) ─
# LLM_API_KEY=                                           # [opt] backend-only secret, never sent to the web
# LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=provider/model-a
# LLM_EXTRA_BODY={"chat_template_kwargs":{"enable_thinking":false}}
PROMPT_VERSION=inv-1.0

# ── Demo and operations ──────────────────────────────────────────────────────────
DEMO_MODE=true
ALLOW_DEMO_SEED=true
# Development sign-in (Bearer dev:<email>:<role>) for demo_check/platform_check.
# Refused at startup when ENVIRONMENT=production. Never enable on a public deployment.
DEV_AUTH_ENABLED=true
LOG_LEVEL=info

# ── Web3 report registry (docs/02-architecture/WEB3_REGISTRY.md §7) ─────────────
# LOCAL CHAIN ONLY. Unset CHAIN_RPC_URL ⇒ anchor routes answer 503 CHAIN_UNAVAILABLE; nothing else
# depends on the chain. Production refuses CHAIN_ID=31337; public-testnet anchoring is not built.
# CHAIN_RPC_URL=http://127.0.0.1:8545
# CHAIN_ID=31337
# CHAIN_REGISTRY_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
# CHAIN_SENDER_ADDRESS=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266
# CHAIN_TIMEOUT_SECONDS=5

# ── External intelligence (docs/02-architecture/THREAT_INTELLIGENCE_SOURCES.md) ─
# INTEL_MODE=auto                                        # auto | live | fixture | off
# URLHAUS_AUTH_KEY=                                      # [opt] abuse.ch key; sends only the scanned hostname
