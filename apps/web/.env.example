# TrustLens web dashboard — names and placeholders only. Copy to .env.local.
# Owner: docs/08-infrastructure/ENVIRONMENT_CONFIGURATION.md

# FastAPI origin (no trailing slash)
VITE_API_BASE_URL=http://localhost:8000

# Clerk publishable key. Leave empty to use the development sign-in
# (requires DEV_AUTH_ENABLED=true on the API, development only).
VITE_CLERK_PUBLISHABLE_KEY=

# Shows the demo banner and the demonstration tools panel
VITE_DEMO_MODE=true

# Displayed in settings and sent as X-Client: web/<version>
VITE_APP_VERSION=0.1.0

# Deliberately absent: VITE_SUPABASE_URL / VITE_SUPABASE_PUBLISHABLE_KEY. The browser never talks to
# Supabase (the API is the only database client and RLS denies the anon role), and Supabase Auth is
# not used — identity is Clerk only. Every VITE_* value is compiled into the public bundle: never
# put a secret here.
