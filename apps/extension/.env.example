# Build-time configuration for the TrustLens extension (read by scripts/build.mjs).
# Copy to .env (git-ignored) or export in the shell before `pnpm --filter @trustlens/extension build`.

# TrustLens API origin. The only origin the service worker will ever call.
VITE_API_BASE_URL=http://localhost:8000

# Dashboard origin, used for "Full report" links (<web>/app/scan/<scan_id>).
VITE_WEB_BASE_URL=http://localhost:5173

# Optional: demo-sites path mode. When set, http://localhost:8081/site/<host>/<path> is reported to the
# API as https://<host>/<path>. Leave empty for a non-demo build.
VITE_DEMO_SITES_ORIGIN=http://localhost:8081
