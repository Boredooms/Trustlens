{
  "name": "@trustlens/shared-types",
  "version": "0.1.0",
  "private": true,
  "description": "Generated from apps/api/openapi.json — never hand-edit. Regenerate with `pnpm gen:types`.",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "gen": "openapi-typescript ../../apps/api/openapi.json -o src/openapi.ts",
    "typecheck": "tsc --noEmit -p ."
  },
  "devDependencies": {
    "openapi-typescript": "^7.4.0",
    "typescript": "^5.6.0"
  }
}
