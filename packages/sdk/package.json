{
  "name": "@boredooms/trustlens-sdk",
  "version": "0.1.0",
  "description": "TypeScript client for the TrustLens API. ALLOW means no known threat within executed checks — never a guarantee.",
  "license": "MIT",
  "author": "Boredooms",
  "homepage": "https://github.com/Boredooms/Trustlens/tree/main/packages/sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Boredooms/Trustlens.git",
    "directory": "packages/sdk"
  },
  "bugs": "https://github.com/Boredooms/Trustlens/issues",
  "keywords": [
    "trustlens",
    "phishing",
    "security",
    "url-scanner",
    "payment-verification",
    "sdk"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "prepublishOnly": "pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
